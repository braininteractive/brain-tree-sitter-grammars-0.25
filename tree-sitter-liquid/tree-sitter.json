{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "liquid",
      "camelcase": "Liquid",
      "title": "Liquid",
      "scope": "source.liquid",
      "file-types": [
        "liquid"
      ],
      "injection-regex": "^liquid$",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "class-name": "TreeSitterLiquid"
    }
  ],
  "metadata": {
    "version": "0.25.0",
    "license": "MIT",
    "description": "liquid grammar for tree-sitter",
    "authors": [
      {
        "name": "derek stride"
      },
      {
        "name": "hank jackson"
      }
    ],
    "links": {
      "repository": "https://github.com/hankthetank27/tree-sitter-liquid"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
