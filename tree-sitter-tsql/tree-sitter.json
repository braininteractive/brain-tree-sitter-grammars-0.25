{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "tsql",
      "camelcase": "Tsql",
      "title": "TSQL",
      "scope": "source.tsql",
      "file-types": [
        "sql"
      ],
      "injection-regex": "^tsql$",
      "class-name": "TreeSitterTsql"
    }
  ],
  "metadata": {
    "version": "0.25.0",
    "license": "MIT",
    "description": "TSQL grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/Crary-Systems/tree-sitter-tsql"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
