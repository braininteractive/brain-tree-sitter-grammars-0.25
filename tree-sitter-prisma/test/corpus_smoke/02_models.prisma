model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  role      Role     @default(VIEWER)
  posts     Post[]
  createdAt DateTime @default(now())
}

model Post {
  id       Int    @id @default(autoincrement())
  title    String @db.VarChar(255)
  author   User   @relation(fields: [authorId], references: [id])
  authorId Int
}
