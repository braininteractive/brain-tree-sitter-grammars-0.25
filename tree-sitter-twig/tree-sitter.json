{
  "grammars": [
    {
      "name": "twig",
      "camelcase": "Twig",
      "scope": "text.html.twig",
      "path": ".",
      "file-types": [
        "twig",
        "html.twig"
      ],
      "injection-regex": "twig",
      "highlights": [
        "queries/highlights.scm"
      ],
      "injections": [
        "queries/injections.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.25.0",
    "license": "WTFPL",
    "description": "Twig grammar for tree-sitter",
    "authors": [
      {
        "name": "gbprod",
        "email": "contact@gb-prod.fr"
      }
    ],
    "links": {
      "repository": "https://github.com/gbprod/tree-sitter-twig"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
