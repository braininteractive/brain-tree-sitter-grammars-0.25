PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ex: <http://example.org/ns#>

SELECT ?ancestor ?class
WHERE {
  ?person foaf:knows+ ?friendOfFriend .
  ?person (ex:motherOf|ex:fatherOf)+ ?ancestor .
  ?class rdfs:subClassOf* ex:Agent .
  ?doc ^ex:cites ?citingDoc .
  ?start ex:next? ?maybeNext .
}
